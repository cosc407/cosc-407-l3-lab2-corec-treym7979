# What core C's given barrier and alternative are supposed to do.
# Read by tests/run_tests.sh, which is identical in all four cores.

VARIATION=C

ALT_LABEL="the blocking barrier: mutex, condition variable, generation number"
ALT_CORRECT=yes

# See core A's expect.env for the list of checks.
#
# NOTHING is auto-checked for this core, and that is deliberate. Everything
# core C's given barrier does is correct; what is wrong with it only appears
# when there are more threads than cores, and the thread count where that
# happens IS the machine -- four on a two-core Codespace, thirty-two on a lab
# PC. A pass/fail threshold would be marking the hardware. The sweep in
# RESULTS.md is the evidence and a person reads it.
CORE_CHECK=none

# The given barrier does not stop, but at more threads than cores it can take
# minutes -- so the fixed/alt checks here still want a real watchdog, and any
# run of `given` above the core count wants BAR_WATCHDOG set by hand.
WATCHDOG=10
